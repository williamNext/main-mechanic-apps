# Path to the SQLite database file used by this server. Required — no default.
DB_PATH=./data/dev.sqlite

# Port the HTTP server listens on. Optional — defaults to 3000.
PORT=3000

# Secret used to sign/verify JWT access tokens. Required, minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-string-at-least-32-characters-long

# Access token lifetime in seconds. Optional — defaults to 2592000 (30 days).
JWT_EXPIRY_SECONDS=2592000
